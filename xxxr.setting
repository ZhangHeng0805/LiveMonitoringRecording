#监控平台服务端口 占用自动累加
server.monitor.port=8005
server.runMode=FILE
#普通接口令牌：公开签发，无需秘钥；关闭后普通接口也必须先换秘钥令牌
server.auth.publicTokenEnabled=true
#普通令牌有效期（秒），默认 30 分钟
server.auth.publicTokenExpireSec=1800
#普通令牌签发每IP每分钟次数（0为不限）
server.api.publicTokenPerMinute=30
#作品解析每IP每分钟次数（0为不限）
server.api.parsePerMinute=5
#微信客户端通用对象
#notice.weChat.target=文件传输助手
#息知通知地址
#notice.xiZhi.url=
#notice.xiZhi.url=https://xizhi.qqoq.net/***.send
#notice.xiZhi.url=https://xizhi.qqoq.net/***.channel
#是否转换录制的视频
record.FlvToMp4=true
#录制类型：JAVA-使用java编写的录制，FFMPEG-使用ffmpeg工具录制
record.type=FFMPEG
#ffmpeg的路径
record.ffmpegPath=bin/ffmpeg.exe
#激活凭证文件路径，默认xxxr-activation.lic
activation.filePath=xxxr-activation.lic
#首次使用试用天数（没有激活文件时生效，0或负数表示不开放试用）
activation.trialDays=7
#是否循环监听直播（直播结束后，重新监听）
record.isLoop=true
#是否开启弹幕记录（目前只对抖音有效）
record.openSubtitle=true
#监听间隔时长（秒）
monitor.delayIntervalSec=30
#是否隐藏监听浏览器
#monitor.browser.headless=false
#直播开始时触发的快捷键(小写，多个组合之间逗号分割，例：alt+tab,ctrl+s)
living.start.shortcut=
#直播结束时触发的快捷键
living.end.shortcut=
#B站的Cookie 也可以指定文本文件file:Bili.txt
Cookie.Bilibili=
#抖音的Cookie
Cookie.DouYin=
#快手的Cookie
Cookie.KuaiShou=