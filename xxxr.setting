#\u76D1\u63A7\u5E73\u53F0\u670D\u52A1\u7AEF\u53E3 \u5360\u7528\u81EA\u52A8\u7D2F\u52A0
server.monitor.port=8005
server.runMode=FILE
#\u5FAE\u4FE1\u5BA2\u6237\u7AEF\u901A\u7528\u5BF9\u8C61
#notice.weChat.target=\u6587\u4EF6\u4F20\u8F93\u52A9\u624B
#\u606F\u77E5\u901A\u77E5\u5730\u5740
#notice.xiZhi.url=
#notice.xiZhi.url=https://xizhi.qqoq.net/***.send
#notice.xiZhi.url=https://xizhi.qqoq.net/***.channel
#\u662F\u5426\u8F6C\u6362\u5F55\u5236\u7684\u89C6\u9891
record.FlvToMp4=true
#\u5F55\u5236\u7C7B\u578B\uFF1AJAVA-\u4F7F\u7528java\u7F16\u5199\u7684\u5F55\u5236\uFF0CFFMPEG-\u4F7F\u7528ffmpeg\u5DE5\u5177\u5F55\u5236
record.type=FFMPEG
#ffmpeg\u7684\u8DEF\u5F84
record.ffmpegPath=bin/ffmpeg.exe
#\u6FC0\u6D3B\u51ED\u8BC1\u6587\u4EF6\u8DEF\u5F84\uFF0C\u9ED8\u8BA4xxxr-activation.lic
activation.filePath=xxxr-activation.lic
#\u662F\u5426\u5FAA\u73AF\u76D1\u542C\u76F4\u64AD\uFF08\u76F4\u64AD\u7ED3\u675F\u540E\uFF0C\u91CD\u65B0\u76D1\u542C\uFF09
record.isLoop=true
#\u662F\u5426\u5F00\u542F\u5F39\u5E55\u8BB0\u5F55\uFF08\u76EE\u524D\u53EA\u5BF9\u6296\u97F3\u6709\u6548\uFF09
record.openSubtitle=true
#\u76D1\u542C\u95F4\u9694\u65F6\u957F\uFF08\u79D2\uFF09
monitor.delayIntervalSec=30
#\u662F\u5426\u9690\u85CF\u76D1\u542C\u6D4F\u89C8\u5668
#monitor.browser.headless=false
#\u76D1\u542C\u6D4F\u89C8\u5668\u662F\u5426\u6BCF\u6B21\u6253\u5F00\u9875\u9762\u65F6\u91CD\u7F6E\u72B6\u6001
monitor.browser.isPageClear=false
#\u66F4\u65B0BrowserContext\u7684\u8BF7\u6C42\u6B21\u6570\uFF0C\u9ED8\u8BA4\u4E0D\u66F4\u65B0
monitor.browser.updateContextCounts=50
#\u76F4\u64AD\u5F00\u59CB\u65F6\u89E6\u53D1\u7684\u5FEB\u6377\u952E(\u5C0F\u5199\uFF0C\u591A\u4E2A\u7EC4\u5408\u4E4B\u95F4\u9017\u53F7\u5206\u5272\uFF0C\u4F8B\uFF1Aalt+tab,ctrl+s)
living.start.shortcut=
#\u76F4\u64AD\u7ED3\u675F\u65F6\u89E6\u53D1\u7684\u5FEB\u6377\u952E
living.end.shortcut=
#B\u7AD9\u7684Cookie \u4E5F\u53EF\u4EE5\u6307\u5B9A\u6587\u672C\u6587\u4EF6file:Bili.txt
Cookie.Bilibili=
